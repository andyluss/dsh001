{
  "manifestVersion": 1,
  "name": "神族",
  "nameEn": "Protoss",
  "description": "星际争霸 · 神族：古老、精密、几乎不落地。抛光石材与金、灵能青辉；辉光没有一丝模糊，光也没有来源 —— 悬浮自发光。",
  "accent": "#b8891f",
  "tags": [
    "starcraft",
    "protoss",
    "psionic",
    "crystalline"
  ],
  "styles": [
    "base.css"
  ],
  "params": [
    {
      "key": "glass",
      "type": "number",
      "label": "玻璃通透度",
      "description": "面板遮住底纹的程度，越大越透",
      "group": "材质",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 52
    },
    {
      "key": "blur",
      "type": "number",
      "label": "磨砂强度",
      "description": "浮层背后的模糊半径",
      "group": "材质",
      "min": 0,
      "max": 24,
      "step": 1,
      "default": 12,
      "unit": "px"
    },
    {
      "key": "psionic",
      "type": "number",
      "label": "灵能辉光",
      "description": "灵能导管的辉光强度。0 = 熄灭的古代装置",
      "group": "材质",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 58
    },
    {
      "key": "intensity",
      "type": "number",
      "label": "整体强度",
      "description": "所有材质层的统一倍率",
      "group": "氛围",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 60
    },
    {
      "key": "accent",
      "type": "color",
      "label": "强调色",
      "description": "按钮、链接与描边的色相",
      "group": "氛围",
      "default": "#b8891f"
    },
    {
      "key": "motion",
      "type": "boolean",
      "label": "动效",
      "description": "关闭后所有循环动画停止",
      "group": "动效",
      "default": true
    },
    {
      "key": "vignette",
      "type": "number",
      "label": "暗角",
      "description": "画面四周压暗的程度",
      "group": "氛围",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 45
    },
    {
      "key": "grain",
      "type": "number",
      "label": "底纹保留",
      "description": "材质层的整体可见度，0 = 完全平坦",
      "group": "材质",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 50
    }
  ],
  "presets": [
    {
      "id": "restrained",
      "name": "克制",
      "description": "材质压到最低，接近纯色界面",
      "values": {
        "glass": 34,
        "blur": 8,
        "intensity": 30,
        "motion": false,
        "grain": 18,
        "vignette": 40
      }
    },
    {
      "id": "standard",
      "name": "标准",
      "description": "默认档位",
      "values": {}
    },
    {
      "id": "cinematic",
      "name": "电影感",
      "description": "材质与动效拉满",
      "values": {
        "glass": 74,
        "blur": 20,
        "intensity": 92,
        "motion": true,
        "grain": 88,
        "vignette": 62
      }
    }
  ]
}
