{
  "manifestVersion": 1,
  "name": "AeroGlass",
  "nameEn": "Aero Glass",
  "description": "极简玻璃 · 纯色底 · 厚面板 · 几乎无气泡，长文与代码优先",
  "accent": "#1f8fd6",
  "tags": ["minimal", "flat", "legibility"],
  "defaults": {
    "accent": "#1f8fd6",
    "wallpaper": "plain",
    "glass": 10,
    "blur": 8,
    "gloss": 26,
    "bubbleAmount": 10,
    "bubbleCycle": 260
  },
  "presets": [
    {
      "id": "standard",
      "name": "标准（极简）",
