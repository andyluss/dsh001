      "values": { "glass": 10, "blur": 8, "gloss": 26, "bubbleAmount": 10, "bubbleCycle": 260 }
    },
    {
      "id": "airy",
      "name": "透气",
      "description": "极简但保留一点壁纸的呼吸感",
      "values": { "glass": 34, "blur": 10, "gloss": 40, "bubbleAmount": 26, "bubbleCycle": 220 }
    }
  ],
  "styles": ["skin.css"]
}
