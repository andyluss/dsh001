{
  "manifestVersion": 1,
  "name": "生物朋克家族",
  "nameEn": "Biopunk Family",
  "description": "硅对碳的湿件朋克。它是七支里最不怀旧的一支——素材是当下的细胞与基因，写的是「现在的下一格」，复古只落在母题层，**视觉上没有年代脸**。所以它的识别完全由材质承担：没有一条硬边，所有高光都向内发光。",
  "accent": "#5bff9e",
  "tags": ["biopunk", "wetware", "membrane", "lab"],
  "styles": ["base.css"],
  "params": [
    {
      "key": "glass",
      "type": "number",
      "label": "玻璃通透度",
      "description": "面板遮住底纹的程度，越大越透",
      "group": "材质",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 52
    },
    {
      "key": "blur",
      "type": "number",
      "label": "磨砂强度",
      "group": "材质",
      "min": 0,
      "max": 24,
      "step": 1,
      "default": 12,
      "unit": "px"
    },
    {
      "key": "accent",
      "type": "color",
      "label": "强调色",
      "description": "卷内的光源语汇只有培养皿冷光与荧光绿——建议不要引入霓虹粉紫",
      "group": "材质",
      "default": "#5bff9e"
    },
    {
      "key": "intensity",
      "type": "number",
      "label": "氛围总强度",
      "description": "统一缩放湿润与膜层",
      "group": "氛围",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 60
    },
    {
      "key": "motion",
      "type": "boolean",
      "label": "标志性动效",
      "description": "含家族级的呼吸与各支的专属动效；关掉即完全静止",
      "group": "氛围",
      "default": true
    },
    {
      "key": "wetness",
      "type": "number",
      "label": "湿润感",
      "description": "本家族的主控参数：内发光的强度与高光的柔度。碳的湿润对硅的干燥",
      "group": "湿件",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 60
    },
    {
      "key": "pulse",
      "type": "number",
      "label": "生物脉冲",
      "description": "呼吸式明度起伏的幅度。0 时画面完全静止",
      "group": "湿件",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 40
    },
    {
      "key": "membrane",
      "type": "number",
      "label": "膜层",
      "description": "面板边缘那圈半透明内发光的厚度——它取代了硬边框",
      "group": "湿件",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 60
    }
  ],
  "presets": [
    {
      "id": "restrained",
      "name": "克制",
      "description": "湿润与脉冲压到最低，接近干燥的扁平界面，可读性优先",
      "values": { "glass": 72, "blur": 8, "intensity": 24, "wetness": 26, "pulse": 8, "membrane": 34, "motion": false }
    },
    {
      "id": "standard",
      "name": "标准",
      "description": "该支皮肤的设计意图原样呈现",
      "values": { "glass": 52, "blur": 12, "intensity": 60, "wetness": 60, "pulse": 40, "membrane": 60, "motion": true }
    },
    {
      "id": "cinematic",
      "name": "浓烈",
      "description": "湿润、脉冲与膜层拉满，适合展示",
      "values": { "glass": 38, "blur": 16, "intensity": 92, "wetness": 86, "pulse": 62, "membrane": 82, "motion": true }
    }
  ]
}
